# Eleanor Platform - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================
# GRAFANA SECURITY SETTINGS
# ============================================

# Admin credentials (CHANGE THESE!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_strong_password

# Secret key for signing (generate random string)
# Generate with: openssl rand -hex 32
GRAFANA_SECRET_KEY=change_me_to_random_secret_key

# ============================================
# TRADING CONFIGURATION
# ============================================

# Initial trading capital (USD)
INITIAL_CAPITAL=15000

# Paper trading mode (true = simulation, false = real money)
PAPER_TRADING=true

# Scraping interval in minutes
SCRAPE_INTERVAL_MINUTES=15

# Headless browser mode (true for production)
USE_HEADLESS=true

# ============================================
# METRICS CONFIGURATION
# ============================================

# Enable Prometheus metrics
ENABLE_METRICS=true

# Metrics endpoint port
METRICS_PORT=8000

# ============================================
# PRIVACY & PROXY SETTINGS
# ============================================

# Use proxy rotation
USE_PROXY=false

# Proxy list (comma-separated)
# Example: http://proxy1:8080,http://proxy2:8080
PROXY_LIST=

# VPN interface (for network monitoring)
VPN_INTERFACE=tun0

# ============================================
# LOGGING
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=./logs/arbitrage_bot.log

# ============================================
# ALERTING (Optional)
# ============================================

# Telegram bot token (for alerts)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID
TELEGRAM_CHAT_ID=

# Email for alerts
ALERT_EMAIL=

# ============================================
# AI MODEL SETTINGS
# ============================================

# Minimum confidence score for trades (0.0-1.0)
MIN_CONFIDENCE=0.6

# Minimum profit percentage
MIN_PROFIT_PCT=0.5

# Maximum risk score (0.0-1.0)
MAX_RISK_SCORE=0.6

# ============================================
# DATABASE (Optional - for production)
# ============================================

# PostgreSQL connection (if using database storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/eleanor

# ============================================
# SECURITY NOTES
# ============================================

# 1. NEVER commit .env to Git (it's in .gitignore)
# 2. Use strong, unique passwords
# 3. Rotate secrets regularly
# 4. Keep metrics endpoint firewalled
# 5. Use VPN in production
# 6. Enable 2FA on Grafana in production
