[Unit]
Description=Eleanor DeFi Arbitrage Trading Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/trading/EleanorPlatform/src/eleanor
Environment="PATH=/home/%i/trading/EleanorPlatform/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# VPN Check before starting
ExecStartPre=/bin/bash -c 'curl -sf https://am.i.mullvad.net/json | grep -q "mullvad_exit_ip\":true" || exit 1'

# Start trading
ExecStart=/home/%i/trading/EleanorPlatform/venv/bin/python run_paper_trading.py \
    --capital 15000 \
    --duration 168 \
    --interval 30 \
    --min-profit 0.2 \
    --max-trade-size 5000

# Restart policy
Restart=on-failure
RestartSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/trading/EleanorPlatform/src/eleanor/results
ReadWritePaths=/home/%i/trading/EleanorPlatform/src/eleanor/data
ReadWritePaths=/home/%i/trading/EleanorPlatform/logs

# Resource limits
LimitNOFILE=65536
CPUQuota=200%
MemoryMax=4G

# Logging
StandardOutput=append:/home/%i/trading/EleanorPlatform/logs/trading.log
StandardError=append:/home/%i/trading/EleanorPlatform/logs/trading-error.log

[Install]
WantedBy=multi-user.target
